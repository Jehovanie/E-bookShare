{% extends 'admin/layout.html.twig' %}

{% block title %}Utilisateurs — Admin EbookShare{% endblock %}
{% block admin_title %}Gestion des utilisateurs{% endblock %}

{% block admin_content %}

{# ── SEARCH + COUNT ───────────────────────────────────────────── #}
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
    <p class="text-sm text-gray-500">
        <span class="font-bold text-gray-800">{{ total }}</span> utilisateur{{ total != 1 ? 's' : '' }}
        {% if search %} pour « <em>{{ search }}</em> »{% endif %}
    </p>
    <form method="GET" action="{{ path('app_admin_users') }}" class="flex gap-2">
        <input type="text" name="q" value="{{ search }}"
               placeholder="Rechercher un utilisateur…"
               class="text-sm bg-white border border-gray-200 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-300 w-60">
        <button type="submit"
                class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition">
            Rechercher
        </button>
        {% if search %}
            <a href="{{ path('app_admin_users') }}" class="text-sm text-gray-400 hover:text-gray-600 px-3 py-2 rounded-xl bg-gray-100 transition">✕</a>
        {% endif %}
    </form>
</div>

{# ── TABLE ────────────────────────────────────────────────────── #}
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-100 text-xs font-bold text-gray-400 uppercase tracking-wider">
                <th class="px-5 py-3 text-left">Utilisateur</th>
                <th class="px-5 py-3 text-left hidden md:table-cell">Email</th>
                <th class="px-5 py-3 text-center">Rôle</th>
                <th class="px-5 py-3 text-center hidden sm:table-cell">Livres</th>
                <th class="px-5 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
            {% for user in users %}
                <tr class="hover:bg-gray-50 transition group" id="user-row-{{ user.id }}">

                    {# Identity #}
                    <td class="px-5 py-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-400 to-violet-500 flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                                {{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800 leading-none">{{ user.firstname }} {{ user.lastname }}</p>
                                <p class="text-xs text-indigo-500">@{{ user.pseudo }}</p>
                            </div>
                        </div>
                    </td>

                    {# Email #}
                    <td class="px-5 py-3 text-gray-500 hidden md:table-cell text-xs truncate max-w-[180px]">{{ user.email }}</td>

                    {# Role badge #}
                    <td class="px-5 py-3 text-center">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="bg-red-100 text-red-600 text-xs font-bold px-2.5 py-0.5 rounded-full">Admin</span>
                        {% else %}
                            <span class="bg-gray-100 text-gray-500 text-xs px-2.5 py-0.5 rounded-full">User</span>
                        {% endif %}
                    </td>

                    {# Books count #}
                    <td class="px-5 py-3 text-center hidden sm:table-cell">
                        <span class="font-semibold text-indigo-600">{{ user.books|length }}</span>
                    </td>

                    {# Actions #}
                    <td class="px-5 py-3">
                        <div class="flex items-center justify-end gap-1.5">

                            {# Toggle Admin #}
                            {% if user != app.user %}
                                <form action="{{ path('app_admin_user_toggle_admin', {id: user.id}) }}" method="POST">
                                    <button type="submit"
                                            title="{{ 'ROLE_ADMIN' in user.roles ? 'Retirer admin' : 'Rendre admin' }}"
                                            class="text-xs px-2.5 py-1.5 rounded-lg border transition
                                                   {{ 'ROLE_ADMIN' in user.roles
                                                       ? 'bg-red-50 text-red-500 border-red-200 hover:bg-red-500 hover:text-white'
                                                       : 'bg-gray-50 text-gray-500 border-gray-200 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200' }}">
                                        {{ 'ROLE_ADMIN' in user.roles ? '⬇ Rétrograder' : '⬆ Promouvoir' }}
                                    </button>
                                </form>
                            {% endif %}

                            {# Reset password #}
                            <button onclick="openResetModal({{ user.id }}, '@{{ user.pseudo|e('js') }}')"
                                    class="text-xs px-2.5 py-1.5 rounded-lg border bg-amber-50 text-amber-600 border-amber-200 hover:bg-amber-500 hover:text-white transition">
                                🔑 MDP
                            </button>

                            {# Delete #}
                            {% if user != app.user %}
                                <button onclick="openDeleteUserModal({{ user.id }}, '@{{ user.pseudo|e('js') }}')"
                                        class="text-xs px-2.5 py-1.5 rounded-lg border bg-red-50 text-red-500 border-red-200 hover:bg-red-500 hover:text-white transition">
                                    🗑
                                </button>
                                <form id="delete-user-form-{{ user.id }}"
                                      action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                      method="POST" class="hidden"></form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-5 py-10 text-center text-gray-400">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# ── PAGINATION ────────────────────────────────────────────────── #}
{% if lastPage > 1 %}
    <div class="flex justify-center items-center gap-2 py-5">
        {% if page > 1 %}
            <a href="{{ path('app_admin_users', {page: page - 1, q: search}) }}"
               class="px-4 py-2 text-sm font-semibold text-indigo-600 bg-white border border-indigo-200 rounded-full hover:bg-indigo-50 transition">← Précédent</a>
        {% endif %}
        <span class="text-sm text-gray-400 px-3">Page {{ page }} / {{ lastPage }}</span>
        {% if page < lastPage %}
            <a href="{{ path('app_admin_users', {page: page + 1, q: search}) }}"
               class="px-4 py-2 text-sm font-semibold text-indigo-600 bg-white border border-indigo-200 rounded-full hover:bg-indigo-50 transition">Suivant →</a>
        {% endif %}
    </div>
{% endif %}

{# ── RESET PASSWORD MODAL ─────────────────────────────────────── #}
<div id="reset-pwd-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-amber-400 to-orange-400"></div>
        <div class="p-6">
            <h2 class="text-base font-extrabold text-gray-900 mb-1">Réinitialiser le mot de passe</h2>
            <p class="text-sm text-gray-500 mb-4">Pour l'utilisateur <span id="reset-user-label" class="font-bold text-indigo-700"></span></p>
            <form id="reset-pwd-form" method="POST" class="space-y-3">
                <input type="password" name="password" placeholder="Nouveau mot de passe (min. 6 car.)"
                       class="w-full text-sm bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-300">
                <div class="flex gap-3 justify-end pt-1">
                    <button type="button" onclick="closeModals()"
                            class="px-5 py-2 rounded-full text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">Annuler</button>
                    <button type="submit"
                            class="px-5 py-2 rounded-full text-sm font-bold text-white bg-amber-500 hover:bg-amber-600 transition shadow">Réinitialiser</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ── DELETE USER MODAL ────────────────────────────────────────── #}
<div id="delete-user-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-red-500 to-rose-400"></div>
        <div class="p-6 text-center">
            <div class="text-4xl mb-3">🗑️</div>
            <h2 class="text-base font-extrabold text-gray-900 mb-1">Supprimer l'utilisateur ?</h2>
            <p class="text-sm font-bold text-indigo-700 mb-2" id="delete-user-label"></p>
            <p class="text-xs text-red-400 mb-5">Tous ses livres, commentaires et likes seront supprimés.</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModals()"
                        class="px-5 py-2 rounded-full text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">Annuler</button>
                <button id="delete-user-confirm-btn"
                        class="px-5 py-2 rounded-full text-sm font-bold text-white bg-red-500 hover:bg-red-600 transition shadow">Supprimer</button>
            </div>
        </div>
    </div>
</div>

<script>
let _deleteUserId = null;

function openResetModal(userId, pseudo) {
    const form = document.getElementById('reset-pwd-form');
    form.action = '/admin/users/' + userId + '/reset-password';
    document.getElementById('reset-user-label').textContent = pseudo;
    showModal('reset-pwd-modal');
}

function openDeleteUserModal(userId, pseudo) {
    _deleteUserId = userId;
    document.getElementById('delete-user-label').textContent = pseudo;
    showModal('delete-user-modal');
}

document.getElementById('delete-user-confirm-btn').addEventListener('click', () => {
    if (_deleteUserId) document.getElementById('delete-user-form-' + _deleteUserId).submit();
});

function showModal(id) {
    const m = document.getElementById(id);
    m.classList.remove('hidden');
    m.classList.add('flex');
}

function closeModals() {
    ['reset-pwd-modal', 'delete-user-modal'].forEach(id => {
        const m = document.getElementById(id);
        m.classList.add('hidden');
        m.classList.remove('flex');
    });
    _deleteUserId = null;
}

document.querySelectorAll('#reset-pwd-modal, #delete-user-modal').forEach(modal => {
    modal.addEventListener('click', e => { if (e.target === modal) closeModals(); });
});
</script>

{% endblock %}

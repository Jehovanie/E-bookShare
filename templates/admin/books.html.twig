{% extends 'admin/layout.html.twig' %}

{% block title %}Publications — Admin EbookShare{% endblock %}
{% block admin_title %}Gestion des publications{% endblock %}

{% block admin_content %}

{# ── SEARCH + COUNT ───────────────────────────────────────────── #}
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
    <p class="text-sm text-gray-500">
        <span class="font-bold text-gray-800">{{ total }}</span> publication{{ total != 1 ? 's' : '' }}
        {% if search %} pour « <em>{{ search }}</em> »{% endif %}
    </p>
    <form method="GET" action="{{ path('app_admin_books') }}" class="flex gap-2">
        <input type="text" name="q" value="{{ search }}"
               placeholder="Titre, auteur…"
               class="text-sm bg-white border border-gray-200 rounded-xl px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-300 w-60">
        <button type="submit"
                class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-xl transition">
            Rechercher
        </button>
        {% if search %}
            <a href="{{ path('app_admin_books') }}" class="text-sm text-gray-400 hover:text-gray-600 px-3 py-2 rounded-xl bg-gray-100 transition">✕</a>
        {% endif %}
    </form>
</div>

{# ── TABLE ────────────────────────────────────────────────────── #}
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-100 text-xs font-bold text-gray-400 uppercase tracking-wider">
                <th class="px-5 py-3 text-left">Titre</th>
                <th class="px-5 py-3 text-left hidden md:table-cell">Auteur</th>
                <th class="px-5 py-3 text-center hidden sm:table-cell">Date</th>
                <th class="px-5 py-3 text-center">📄</th>
                <th class="px-5 py-3 text-center">❤️</th>
                <th class="px-5 py-3 text-center">💬</th>
                <th class="px-5 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
            {% for book in books %}
                <tr class="hover:bg-gray-50 transition">

                    {# Title #}
                    <td class="px-5 py-3">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br
                                {% if book.id % 4 == 0 %}from-indigo-100 to-violet-200
                                {% elseif book.id % 4 == 1 %}from-violet-100 to-purple-200
                                {% elseif book.id % 4 == 2 %}from-pink-100 to-rose-200
                                {% else %}from-teal-100 to-cyan-200{% endif %}
                                flex items-center justify-center text-sm flex-shrink-0">📖</div>
                            <div class="min-w-0">
                                <p class="font-semibold text-gray-800 truncate max-w-[180px]">{{ book.title }}</p>
                                <p class="text-xs text-gray-400 truncate max-w-[180px]">{{ book.description|slice(0, 60) }}…</p>
                            </div>
                        </div>
                    </td>

                    {# Author #}
                    <td class="px-5 py-3 hidden md:table-cell">
                        <div class="flex items-center gap-1.5">
                            <div class="w-6 h-6 rounded-full bg-gradient-to-br from-indigo-400 to-violet-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                {{ book.owner.firstname|first|upper }}{{ book.owner.lastname|first|upper }}
                            </div>
                            <span class="text-xs text-gray-600">@{{ book.owner.pseudo }}</span>
                        </div>
                    </td>

                    {# Date #}
                    <td class="px-5 py-3 text-center text-xs text-gray-400 hidden sm:table-cell">
                        {{ book.uploadetat|date('d/m/Y') }}
                    </td>

                    {# PDF #}
                    <td class="px-5 py-3 text-center">
                        {% if book.filepath %}
                            <a href="/{{ book.filepath }}" target="_blank"
                               class="text-xs bg-red-50 text-red-500 border border-red-100 px-2 py-0.5 rounded-full hover:bg-red-100 transition">
                                PDF
                            </a>
                        {% else %}
                            <span class="text-gray-300 text-xs">—</span>
                        {% endif %}
                    </td>

                    {# Likes #}
                    <td class="px-5 py-3 text-center font-semibold {{ book.likes|length > 0 ? 'text-red-400' : 'text-gray-300' }}">
                        {{ book.likes|length }}
                    </td>

                    {# Comments #}
                    <td class="px-5 py-3 text-center font-semibold {{ book.comments|length > 0 ? 'text-indigo-400' : 'text-gray-300' }}">
                        {{ book.comments|length }}
                    </td>

                    {# Actions #}
                    <td class="px-5 py-3 text-right">
                        <button onclick="confirmDeleteBook({{ book.id }}, '{{ book.title|e('js') }}')"
                                class="text-xs px-2.5 py-1.5 rounded-lg border bg-red-50 text-red-500 border-red-200 hover:bg-red-500 hover:text-white transition">
                            🗑 Supprimer
                        </button>
                        <form id="admin-delete-book-form-{{ book.id }}"
                              action="{{ path('app_admin_book_delete', {id: book.id}) }}"
                              method="POST" class="hidden"></form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-5 py-10 text-center text-gray-400">Aucune publication trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# ── PAGINATION ────────────────────────────────────────────────── #}
{% if lastPage > 1 %}
    <div class="flex justify-center items-center gap-2 py-5">
        {% if page > 1 %}
            <a href="{{ path('app_admin_books', {page: page - 1, q: search}) }}"
               class="px-4 py-2 text-sm font-semibold text-indigo-600 bg-white border border-indigo-200 rounded-full hover:bg-indigo-50 transition">← Précédent</a>
        {% endif %}
        <span class="text-sm text-gray-400 px-3">Page {{ page }} / {{ lastPage }}</span>
        {% if page < lastPage %}
            <a href="{{ path('app_admin_books', {page: page + 1, q: search}) }}"
               class="px-4 py-2 text-sm font-semibold text-indigo-600 bg-white border border-indigo-200 rounded-full hover:bg-indigo-50 transition">Suivant →</a>
        {% endif %}
    </div>
{% endif %}

{# ── DELETE BOOK MODAL ────────────────────────────────────────── #}
<div id="admin-delete-book-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-red-500 to-rose-400"></div>
        <div class="p-6 text-center">
            <div class="text-4xl mb-3">🗑️</div>
            <h2 class="text-base font-extrabold text-gray-900 mb-1">Supprimer cette publication ?</h2>
            <p class="text-sm font-bold text-indigo-700 mb-2" id="admin-delete-book-title"></p>
            <p class="text-xs text-red-400 mb-5">Le fichier PDF sera également supprimé. Action irréversible.</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeBookModal()"
                        class="px-5 py-2 rounded-full text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">Annuler</button>
                <button id="admin-delete-book-confirm"
                        class="px-5 py-2 rounded-full text-sm font-bold text-white bg-red-500 hover:bg-red-600 transition shadow">Supprimer</button>
            </div>
        </div>
    </div>
</div>

<script>
let _deleteBookId = null;

function confirmDeleteBook(id, title) {
    _deleteBookId = id;
    document.getElementById('admin-delete-book-title').textContent = '"' + title + '"';
    const m = document.getElementById('admin-delete-book-modal');
    m.classList.remove('hidden');
    m.classList.add('flex');
}

function closeBookModal() {
    _deleteBookId = null;
    const m = document.getElementById('admin-delete-book-modal');
    m.classList.add('hidden');
    m.classList.remove('flex');
}

document.getElementById('admin-delete-book-confirm').addEventListener('click', () => {
    if (_deleteBookId) document.getElementById('admin-delete-book-form-' + _deleteBookId).submit();
});

document.getElementById('admin-delete-book-modal').addEventListener('click', function(e) {
    if (e.target === this) closeBookModal();
});
</script>

{% endblock %}

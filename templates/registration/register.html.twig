{% extends 'base.html.twig' %}

{% block title %}Créer un compte — EbookShare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .field-row label { display:block; font-size:.875rem; font-weight:600; color:#374151; margin-bottom:.375rem; }
        .field-row input[type=text],
        .field-row input[type=email],
        .field-row input[type=password] {
            width:100%; padding:.75rem 1rem; border-radius:.75rem;
            border:1px solid #e5e7eb; background:#f9fafb; font-size:.875rem;
            transition: all .15s;
        }
        .field-row input:focus { outline:none; background:#fff; border-color:transparent; box-shadow:0 0 0 2px #6366f1; }
        .field-row .form-error { color:#dc2626; font-size:.75rem; margin-top:.25rem; }
        .field-row input[type=checkbox] { width:1rem; height:1rem; accent-color:#6366f1; cursor:pointer; margin-right:.5rem; }
        .checkbox-row { display:flex; align-items:center; }
        .checkbox-row label { font-weight:400; color:#4b5563; cursor:pointer; margin-bottom:0; }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-violet-50 flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-lg">

        {# Brand #}
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-2 text-indigo-700 font-extrabold text-2xl">
                📚 EbookShare
            </a>
            <p class="text-gray-500 text-sm mt-2">Rejoignez la communauté des lecteurs et auteurs.</p>
        </div>

        {# Card #}
        <div class="bg-white rounded-3xl shadow-xl p-8">

            {# Flash errors #}
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm mb-6 flex items-center gap-2">
                    <span>⚠️</span><span>{{ flash_error }}</span>
                </div>
            {% endfor %}

            <h1 class="text-2xl font-extrabold text-gray-900 mb-2">Créer un compte</h1>
            <p class="text-gray-500 text-sm mb-6">Gratuit · Sans carte bancaire</p>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {attr: {class: 'space-y-5', novalidate: 'novalidate'}}) }}

                {# Prénom + Nom (2 colonnes) #}
                <div class="grid grid-cols-2 gap-4">
                    <div class="field-row">
                        {{ form_label(registrationForm.firstname) }}
                        {{ form_widget(registrationForm.firstname) }}
                        {{ form_errors(registrationForm.firstname) }}
                    </div>
                    <div class="field-row">
                        {{ form_label(registrationForm.lastname) }}
                        {{ form_widget(registrationForm.lastname) }}
                        {{ form_errors(registrationForm.lastname) }}
                    </div>
                </div>

                {# Pseudo #}
                <div class="field-row">
                    {{ form_label(registrationForm.pseudo) }}
                    <div id="pseudo_wrapper" class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm z-10">@</span>
                        {{ form_widget(registrationForm.pseudo, {attr: {
                            class: 'pl-7 pr-10',
                            placeholder: 'votre_pseudo',
                            autocomplete: 'off'
                        }}) }}
                        <span id="pseudo_icon" class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"></span>
                    </div>
                    <div id="pseudo_feedback" class="mt-1.5 text-xs"></div>
                    {{ form_errors(registrationForm.pseudo) }}
                </div>

                {# Email #}
                <div class="field-row">
                    {{ form_label(registrationForm.email) }}
                    {{ form_widget(registrationForm.email) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                {# Mot de passe #}
                <div class="field-row">
                    {{ form_label(registrationForm.plainPassword) }}
                    <div class="relative password-wrapper">
                        {{ form_widget(registrationForm.plainPassword, {attr: {style: 'padding-right:2.5rem'}}) }}
                        <button type="button" onclick="togglePwd(this)" tabindex="-1"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 transition focus:outline-none"
                            aria-label="Afficher / masquer le mot de passe">
                            <svg class="eye-open w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.574-3.007-9.964-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            <svg class="eye-closed w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </button>
                    </div>
                    {{ form_errors(registrationForm.plainPassword) }}
                    <p class="text-xs text-gray-400 mt-1">Au moins 6 caractères.</p>
                </div>

                {# CGU #}
                <div class="field-row">
                    <div class="checkbox-row">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms) }}
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>

                {# Submit #}
                <button
                    type="submit"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl shadow transition text-sm mt-2"
                >
                    🚀 Créer mon compte
                </button>

            {{ form_end(registrationForm) }}

            <p class="text-center text-sm text-gray-500 mt-6">
                Déjà un compte ?
                <a href="{{ path('app_login') }}" class="text-indigo-600 font-semibold hover:text-indigo-800 transition">Se connecter</a>
            </p>
        </div>

        <p class="text-center text-xs text-gray-400 mt-6">
            © {{ "now"|date("Y") }} EbookShare — <a href="/" class="hover:text-indigo-500 transition">Retour à l'accueil</a>
        </p>
    </div>
</div>

<script>
function togglePwd(btn) {
    const input = btn.closest('.password-wrapper').querySelector('input');
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.querySelector('.eye-open').classList.toggle('hidden', show);
    btn.querySelector('.eye-closed').classList.toggle('hidden', !show);
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const CHECK_URL = "{{ path('app_register_check_pseudo') }}";

    // Find pseudo input by name (reliable regardless of Symfony-generated id)
    const wrapper  = document.getElementById('pseudo_wrapper');
    const field    = wrapper ? wrapper.querySelector('input') : null;
    const icon     = document.getElementById('pseudo_icon');
    const feedback = document.getElementById('pseudo_feedback');
    const form     = field ? field.closest('form') : null;

    if (!field) { console.warn('[pseudo-check] input not found'); return; }

    let debounceTimer  = null;
    let pseudoIsValid  = false;
    let currentRequest = null;

    const SVG_OK   = '<svg class="w-4 h-4" style="color:#16a34a" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>';
    const SVG_ERR  = '<svg class="w-4 h-4" style="color:#dc2626" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>';
    const SVG_SPIN = '<svg class="w-4 h-4" style="color:#9ca3af;animation:spin 1s linear infinite" fill="none" viewBox="0 0 24 24"><circle style="opacity:.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path style="opacity:.75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>';

    // inject spin keyframes once
    if (!document.getElementById('pseudo-spin-style')) {
        const s = document.createElement('style');
        s.id = 'pseudo-spin-style';
        s.textContent = '@keyframes spin{to{transform:rotate(360deg)}}';
        document.head.appendChild(s);
    }

    function setIcon(svg) {
        icon.innerHTML = svg;
    }

    function setFeedback(html) {
        feedback.innerHTML = html;
    }

    function pickSuggestion(value) {
        field.value = value;
        field.focus();
        runCheck(value);
    }
    window.pickSuggestion = pickSuggestion;

    function runCheck(pseudo) {
        pseudo = pseudo.trim();

        if (pseudo.length < 3) {
            setIcon('');
            setFeedback('');
            pseudoIsValid = false;
            return;
        }

        setIcon(SVG_SPIN);
        setFeedback('');

        if (currentRequest) { currentRequest.abort(); }
        const controller = new AbortController();
        currentRequest = controller;

        fetch(CHECK_URL + '?pseudo=' + encodeURIComponent(pseudo), { signal: controller.signal })
            .then(r => r.json())
            .then(data => {
                currentRequest = null;

                if (data.error) {
                    setIcon(SVG_ERR);
                    setFeedback('<span style="color:#dc2626">Pseudo invalide (3+ caractères, lettres, chiffres, _ ou -).</span>');
                    pseudoIsValid = false;
                    return;
                }

                if (data.available) {
                    setIcon(SVG_OK);
                    setFeedback('<span style="color:#16a34a;font-weight:600">✓ Ce pseudo est disponible !</span>');
                    pseudoIsValid = true;
                } else {
                    setIcon(SVG_ERR);
                    pseudoIsValid = false;

                    let html = '<span style="color:#dc2626;font-weight:600">✗ Ce pseudo est déjà pris.</span>';

                    if (data.suggestions && data.suggestions.length) {
                        html += '&nbsp;<span style="color:#6b7280">Suggestions :</span>';
                        html += '<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px">';
                        data.suggestions.forEach(s => {
                            html += `<button type="button" onclick="pickSuggestion('${s}')" style="display:inline-flex;align-items:center;gap:4px;background:#eef2ff;border:1px solid #a5b4fc;color:#4338ca;font-weight:600;font-size:12px;padding:3px 10px;border-radius:999px;cursor:pointer">@ ${s}</button>`;
                        });
                        html += '</div>';
                    }

                    setFeedback(html);
                }
            })
            .catch(err => {
                if (err.name !== 'AbortError') {
                    setIcon('');
                    pseudoIsValid = false;
                }
            });
    }

    // Trigger on every keystroke (debounced)
    field.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        pseudoIsValid = false;
        setIcon(this.value.trim().length >= 3 ? SVG_SPIN : '');
        setFeedback('');
        debounceTimer = setTimeout(() => runCheck(this.value), 450);
    });

    // Also check on blur (covers paste/autofill)
    field.addEventListener('blur', function () {
        clearTimeout(debounceTimer);
        if (this.value.trim().length >= 3) runCheck(this.value);
    });

    // Block submit if pseudo not validated
    if (form) {
        form.addEventListener('submit', function (e) {
            if (!pseudoIsValid) {
                e.preventDefault();
                e.stopImmediatePropagation();
                field.focus();
                if (field.value.trim().length >= 3) {
                    setIcon(SVG_ERR);
                    if (!feedback.innerHTML.includes('disponible') && !feedback.innerHTML.includes('pris')) {
                        setFeedback('<span style="color:#dc2626;font-weight:600">Veuillez vérifier la disponibilité du pseudo avant de continuer.</span>');
                    }
                } else {
                    setFeedback('<span style="color:#dc2626;font-weight:600">Veuillez choisir un pseudo (min. 3 caractères).</span>');
                }
                field.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    }
});
</script>
{% endblock %}

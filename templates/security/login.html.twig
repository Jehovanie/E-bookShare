{% extends 'base.html.twig' %}

{% block title %}Connexion — EbookShare{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-violet-50 flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">

        {# Logo / Brand #}
        <div class="text-center mb-8">
            <a href="/" class="inline-flex items-center gap-2 text-indigo-700 font-extrabold text-2xl">
                📚 EbookShare
            </a>
            <p class="text-gray-500 text-sm mt-2">Bon retour parmi nous !</p>
        </div>

        {# Card #}
        <div class="bg-white rounded-3xl shadow-xl p-8">

            {# Already logged in #}
            {% if app.user %}
                <div class="bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-xl px-4 py-3 text-sm mb-6">
                    Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                    <a href="{{ logout_path() }}" class="underline ml-1">Se déconnecter</a>
                </div>
            {% endif %}

            {# Error #}
            {% if error %}
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm mb-6 flex items-center gap-2">
                    <span>⚠️</span>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <h1 class="text-2xl font-extrabold text-gray-900 mb-6">Connexion</h1>

            <form method="post" class="space-y-5">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {# Email #}
                <div>
                    <label for="inputEmail" class="block text-sm font-semibold text-gray-700 mb-1.5">Adresse e-mail</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="email"
                        id="inputEmail"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="jean@exemple.com"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition"
                    >
                </div>

                {# Password #}
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="inputPassword" class="block text-sm font-semibold text-gray-700">Mot de passe</label>
                        <a href="#" class="text-xs text-indigo-600 hover:text-indigo-800 transition">Mot de passe oublié ?</a>
                    </div>
                    <div class="relative password-wrapper">
                        <input
                            type="password"
                            name="password"
                            id="inputPassword"
                            autocomplete="current-password"
                            required
                            placeholder="••••••••"
                            class="w-full px-4 py-3 pr-11 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-sm transition"
                        >
                        <button type="button" onclick="togglePwd(this)" tabindex="-1"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 transition focus:outline-none"
                            aria-label="Afficher / masquer le mot de passe">
                            <svg class="eye-open w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.574-3.007-9.964-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            <svg class="eye-closed w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </button>
                    </div>
                </div>

                {# Remember me #}
                <div class="flex items-center gap-2">
                    <input
                        type="checkbox"
                        id="remember_me"
                        name="_remember_me"
                        class="w-4 h-4 rounded accent-indigo-600 cursor-pointer"
                    >
                    <label for="remember_me" class="text-sm text-gray-600 cursor-pointer">Se souvenir de moi</label>
                </div>

                {# Submit #}
                <button
                    type="submit"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl shadow transition text-sm"
                >
                    Se connecter
                </button>
            </form>

            <p class="text-center text-sm text-gray-500 mt-6">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}" class="text-indigo-600 font-semibold hover:text-indigo-800 transition">Créer un compte</a>
            </p>
        </div>

        <p class="text-center text-xs text-gray-400 mt-6">
            © {{ "now"|date("Y") }} EbookShare — <a href="/" class="hover:text-indigo-500 transition">Retour à l'accueil</a>
        </p>
    </div>
</div>

<script>
function togglePwd(btn) {
    const input = btn.closest('.password-wrapper').querySelector('input');
    const show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.querySelector('.eye-open').classList.toggle('hidden', show);
    btn.querySelector('.eye-closed').classList.toggle('hidden', !show);
}
</script>
{% endblock %}

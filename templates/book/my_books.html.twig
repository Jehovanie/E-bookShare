{% extends 'base.html.twig' %}

{% block title %}Mes livres — EbookShare{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .sidebar-col::-webkit-scrollbar { display: none }
        .sidebar-col { -ms-overflow-style: none; scrollbar-width: none }
    </style>
{% endblock %}

{% block body %}

{# ── NAVBAR ─────────────────────────────────────────────────── #}
<nav class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-indigo-700 font-extrabold text-lg">
            📚 EbookShare
        </a>
        <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-500">
            <a href="{{ path('app_feed') }}" class="hover:text-indigo-600 transition">Fil</a>
            <a href="#" class="hover:text-indigo-600 transition">Explorer</a>
            <a href="{{ path('app_my_books') }}" class="text-indigo-600 font-bold border-b-2 border-indigo-600 pb-0.5">Mes livres</a>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center text-white font-bold text-sm select-none">
                    {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                </div>
                <span class="hidden md:block text-sm font-semibold text-gray-700">@{{ app.user.pseudo }}</span>
            </div>
            <a href="{{ path('app_logout') }}" class="text-xs text-gray-400 hover:text-red-500 transition ml-1">Déconnexion</a>
        </div>
    </div>
</nav>

{# ── LAYOUT ──────────────────────────────────────────────────── #}
<div class="max-w-6xl mx-auto px-4 h-[calc(100vh-3.5rem)] overflow-hidden grid grid-cols-1 md:grid-cols-[240px_1fr_240px] gap-6">

    {# ── LEFT SIDEBAR ─────────────────────────────────────────── #}
    <aside class="hidden md:flex flex-col gap-4 overflow-y-auto py-6 sidebar-col">

        {# Profile card #}
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="h-16 bg-gradient-to-r from-indigo-500 to-violet-500"></div>
            <div class="px-4 pb-4 -mt-7">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white font-extrabold text-lg border-4 border-white shadow">
                    {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                </div>
                <p class="font-bold text-gray-900 mt-2 text-sm">{{ app.user.firstname }} {{ app.user.lastname }}</p>
                <p class="text-indigo-600 text-xs font-semibold">@{{ app.user.pseudo }}</p>
                <p class="text-gray-400 text-xs mt-0.5">{{ app.user.email }}</p>
            </div>
        </div>

        {# Nav links #}
        <nav class="bg-white rounded-2xl border border-gray-100 shadow-sm p-3 space-y-0.5 text-sm">
            <a href="{{ path('app_feed') }}" class="flex items-center gap-3 px-3 py-2 rounded-xl text-gray-600 hover:bg-gray-50 hover:text-indigo-600 transition">
                <span>🏠</span> Fil d'actualité
            </a>
            <a href="{{ path('app_my_books') }}" class="flex items-center gap-3 px-3 py-2 rounded-xl bg-indigo-50 text-indigo-700 font-semibold">
                <span>📚</span> Mes livres
            </a>
            <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-xl text-gray-600 hover:bg-gray-50 hover:text-indigo-600 transition">
                <span>❤️</span> Mes favoris
            </a>
            <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-xl text-gray-600 hover:bg-gray-50 hover:text-indigo-600 transition">
                <span>🔍</span> Explorer
            </a>
            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-3 py-2 rounded-xl text-gray-400 hover:bg-red-50 hover:text-red-500 transition">
                <span>🚪</span> Déconnexion
            </a>
        </nav>
    </aside>

    {# ── CENTER ────────────────────────────────────────────────── #}
    <main class="min-w-0 overflow-y-auto py-6 space-y-4">

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="flex items-center gap-2 px-4 py-3 rounded-xl text-sm font-medium
                    {{ type == 'success' ? 'bg-green-50 border border-green-200 text-green-700' : 'bg-red-50 border border-red-200 text-red-700' }}">
                    <span>{{ type == 'success' ? '✅' : '⚠️' }}</span>
                    <span>{{ msg }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        {# Header #}
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-xl font-extrabold text-gray-900">Mes livres</h1>
                <p class="text-sm text-gray-400 mt-0.5">
                    {{ books|length }} livre{{ books|length != 1 ? 's' : '' }} publié{{ books|length != 1 ? 's' : '' }}
                </p>
            </div>
            <a href="{{ path('app_feed') }}"
               class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold px-4 py-2 rounded-full shadow transition">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                Publier un livre
            </a>
        </div>

        {# Book list #}
        {% if books is empty %}
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-16 text-center text-gray-400">
                <div class="text-5xl mb-3">📭</div>
                <p class="font-semibold text-gray-600">Vous n'avez encore publié aucun livre.</p>
                <p class="text-sm mt-1">Partagez votre premier ebook avec la communauté !</p>
                <a href="{{ path('app_feed') }}"
                   class="inline-block mt-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm px-6 py-2.5 rounded-full transition shadow">
                    Publier maintenant
                </a>
            </div>
        {% else %}
            <div class="space-y-3">
                {% for book in books %}
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition overflow-hidden group"
                         id="book-row-{{ book.id }}">

                        {# Accent stripe #}
                        <div class="h-1 w-full bg-gradient-to-r
                            {% if book.id % 4 == 0 %}from-indigo-500 to-violet-500
                            {% elseif book.id % 4 == 1 %}from-violet-500 to-purple-500
                            {% elseif book.id % 4 == 2 %}from-pink-500 to-rose-400
                            {% else %}from-teal-400 to-cyan-500{% endif %}">
                        </div>

                        <div class="p-4 flex gap-4 items-start">

                            {# Book icon #}
                            <div class="hidden sm:flex w-14 h-18 flex-shrink-0 rounded-xl bg-gradient-to-br
                                {% if book.id % 4 == 0 %}from-indigo-100 to-violet-200
                                {% elseif book.id % 4 == 1 %}from-violet-100 to-purple-200
                                {% elseif book.id % 4 == 2 %}from-pink-100 to-rose-200
                                {% else %}from-teal-100 to-cyan-200{% endif %}
                                items-center justify-center text-2xl shadow-inner h-16 w-12 rounded-lg">
                                📖
                            </div>

                            {# Content #}
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <h2 class="font-extrabold text-gray-900 text-base leading-snug truncate">{{ book.title }}</h2>
                                        <p class="text-xs text-gray-400 mt-0.5">Publié le {{ book.uploadetat|date('d M Y') }}</p>
                                    </div>
                                    {# PDF badge #}
                                    {% if book.filepath %}
                                        <span class="flex-shrink-0 bg-red-50 border border-red-100 text-red-600 text-xs font-semibold px-2 py-0.5 rounded-full">📄 PDF</span>
                                    {% endif %}
                                </div>

                                <p class="text-sm text-gray-500 mt-1.5 line-clamp-2">{{ book.description }}</p>

                                {# Stats + actions #}
                                <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100">
                                    <div class="flex items-center gap-4 text-xs text-gray-400">
                                        <span class="flex items-center gap-1">
                                            ❤️ <span class="font-semibold {{ book.likes|length > 0 ? 'text-red-400' : '' }}">{{ book.likes|length }}</span>
                                        </span>
                                        <span class="flex items-center gap-1">
                                            💬 <span class="font-semibold {{ book.comments|length > 0 ? 'text-indigo-400' : '' }}">{{ book.comments|length }}</span>
                                        </span>
                                    </div>

                                    <div class="flex items-center gap-2">
                                        {% if book.filepath %}
                                            <a href="/{{ book.filepath }}" target="_blank"
                                               class="text-xs font-semibold text-gray-500 hover:text-indigo-600 bg-gray-50 hover:bg-indigo-50 border border-gray-200 hover:border-indigo-200 px-3 py-1.5 rounded-full transition flex items-center gap-1.5">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.574-3.007-9.964-7.178Z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                                                </svg>
                                                Lire
                                            </a>
                                        {% endif %}

                                        {# Delete button → opens confirm modal #}
                                        <button onclick="confirmDelete({{ book.id }}, '{{ book.title|e('js') }}')"
                                                class="text-xs font-semibold text-red-500 bg-red-50 hover:bg-red-500 hover:text-white border border-red-200 hover:border-red-500 px-3 py-1.5 rounded-full transition flex items-center gap-1.5">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                            </svg>
                                            Supprimer
                                        </button>

                                        {# Hidden delete form (POST method) #}
                                        <form id="delete-form-{{ book.id }}"
                                              action="{{ path('app_book_delete', {id: book.id}) }}"
                                              method="POST" class="hidden">
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </main>

    {# ── RIGHT SIDEBAR ────────────────────────────────────────── #}
    <aside class="hidden md:flex flex-col gap-4 overflow-y-auto py-6 sidebar-col">

        {# Summary stats #}
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Résumé</h3>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">📚 Livres publiés</span>
                    <span class="font-bold text-indigo-600">{{ books|length }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">❤️ Likes reçus</span>
                    <span class="font-bold text-red-400">{{ books|reduce((carry, b) => carry + b.likes|length, 0) }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">💬 Commentaires</span>
                    <span class="font-bold text-indigo-400">{{ books|reduce((carry, b) => carry + b.comments|length, 0) }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">📄 Avec PDF</span>
                    <span class="font-bold text-gray-700">{{ books|filter(b => b.filepath)|length }}</span>
                </div>
            </div>
        </div>

        {# Top book #}
        {% if books|length > 0 %}
            {% set topBook = books|sort((a, b) => b.likes|length - a.likes|length)|first %}
            <div class="bg-gradient-to-br from-indigo-600 to-violet-600 rounded-2xl p-4 text-white">
                <h3 class="text-xs font-bold text-indigo-200 uppercase tracking-wider mb-2">🏆 Votre meilleur livre</h3>
                <p class="font-bold text-sm leading-snug">{{ topBook.title }}</p>
                <p class="text-indigo-200 text-xs mt-1">❤️ {{ topBook.likes|length }} like{{ topBook.likes|length != 1 ? 's' : '' }} · 💬 {{ topBook.comments|length }} commentaire{{ topBook.comments|length != 1 ? 's' : '' }}</p>
            </div>
        {% endif %}

        {# CTA publish #}
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center">
            <p class="text-3xl mb-2">✍️</p>
            <p class="font-bold text-sm text-gray-800 mb-1">Partagez un nouveau livre</p>
            <p class="text-xs text-gray-400 mb-3">Enrichissez la communauté EbookShare</p>
            <a href="{{ path('app_feed') }}"
               class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-5 py-2 rounded-full transition shadow">
                Publier maintenant
            </a>
        </div>

    </aside>
</div>

{# ── CONFIRM DELETE MODAL ─────────────────────────────────────── #}
<div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-red-500 to-rose-400"></div>
        <div class="p-6 text-center">
            <div class="text-4xl mb-3">🗑️</div>
            <h2 class="text-base font-extrabold text-gray-900 mb-1">Supprimer ce livre ?</h2>
            <p class="text-sm text-gray-500 mb-1">Vous êtes sur le point de supprimer :</p>
            <p class="text-sm font-bold text-indigo-700 mb-4" id="modal-book-title">—</p>
            <p class="text-xs text-red-400 mb-5">Cette action est irréversible. Le fichier PDF sera également supprimé.</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModal()"
                        class="px-5 py-2 rounded-full text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">
                    Annuler
                </button>
                <button id="modal-confirm-btn"
                        class="px-5 py-2 rounded-full text-sm font-bold text-white bg-red-500 hover:bg-red-600 transition shadow">
                    Oui, supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let _deleteBookId = null;

function confirmDelete(bookId, title) {
    _deleteBookId = bookId;
    document.getElementById('modal-book-title').textContent = '"' + title + '"';
    const modal = document.getElementById('delete-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeModal() {
    _deleteBookId = null;
    const modal = document.getElementById('delete-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

document.getElementById('modal-confirm-btn').addEventListener('click', () => {
    if (!_deleteBookId) return;
    document.getElementById('delete-form-' + _deleteBookId).submit();
});

// Close on backdrop click
document.getElementById('delete-modal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});
</script>

{% endblock %}
